        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "description": {
            "type": "string"
          },
          "height": {
            "type": "integer",
            "format": "int32"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "image_bytes": {
            "type": "integer",
            "format": "int32"
          },
          "image_sha256": {
            "type": "string"
