  "components": {
    "schemas": {
      "CreatePostForm": {
        "type": "object",
        "required": [
          "idempotency_key",
          "title",
          "description",
          "image"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "idempotency_key": {
            "type": "string",
            "format": "uuid"
          },
          "image": {
            "type": "string",
            "format": "binary"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "cluster",
          "region",
          "version",
          "read_only"
        ],
        "properties": {
          "cluster": {
            "type": "string"
          },
          "failing": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "read_only": {
            "type": "boolean"
          },
          "region": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
