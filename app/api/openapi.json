        "properties": {
          "next": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "posts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Post"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "secret_code": {
        "type": "http",
        "scheme": "bearer"
